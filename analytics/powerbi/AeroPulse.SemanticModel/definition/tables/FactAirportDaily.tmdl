table FactAirportDaily
	lineageTag: 363f4728-222c-57d1-949e-42f7ae4362f5

	/// Scheduled flight legs at the selected airports (each flight counts once per direction selected).
	measure 'Total Flights' = SUM(FactAirportDaily[flights])
		formatString: #,0
		displayFolder: Volume
		lineageTag: 83305857-39c2-5a80-98e0-cc1cfbfc2b55

	/// Scheduled arrivals.
	measure 'Arrival Flights' = CALCULATE([Total Flights], FactAirportDaily[direction] = "arrival")
		formatString: #,0
		displayFolder: Volume
		lineageTag: e54f0e99-3ec4-5b97-8ce3-3774e2d954df

	/// Scheduled departures.
	measure 'Departure Flights' = CALCULATE([Total Flights], FactAirportDaily[direction] = "departure")
		formatString: #,0
		displayFolder: Volume
		lineageTag: 034eecbd-e46c-585c-93d8-42e9be88d342

	/// BTS-reported cancellations.
	measure 'Cancelled Flights' = SUM(FactAirportDaily[cancelled])
		formatString: #,0
		displayFolder: Volume
		lineageTag: a8917ee0-32f5-5301-93ee-1e342720444b

	/// BTS-reported diversions.
	measure 'Diverted Flights' = SUM(FactAirportDaily[diverted])
		formatString: #,0
		displayFolder: Volume
		lineageTag: a33c5093-acbc-5784-bf3f-f1c775ff63c2

	/// Operated, non-diverted flights 15+ minutes late (DOT definition).
	measure 'Delayed Flights' = SUM(FactAirportDaily[delayed_15])
		formatString: #,0
		displayFolder: Volume
		lineageTag: 50e064f6-ab4a-5f78-a8b2-c9e641de3a2e

	/// On-time (< 15 min late) / operated non-diverted flights with a reported delay. Cancelled and diverted excluded.
	measure 'On-Time %' = DIVIDE(SUM(FactAirportDaily[ontime_num]), SUM(FactAirportDaily[ontime_den]))
		formatString: 0.0%
		displayFolder: Rates
		lineageTag: 4b9a37ad-7b58-59e5-ac60-433258616d38

	/// DOT arrival on-time rate.
	measure 'Arrival On-Time %' = CALCULATE([On-Time %], FactAirportDaily[direction] = "arrival")
		formatString: 0.0%
		displayFolder: Rates
		lineageTag: 43951f4e-8400-568b-a0fc-0c541f6a9dd7

	/// Departure on-time rate.
	measure 'Departure On-Time %' = CALCULATE([On-Time %], FactAirportDaily[direction] = "departure")
		formatString: 0.0%
		displayFolder: Rates
		lineageTag: 904dd133-3b9e-5d3b-b1cb-7fb77a577de0

	/// Cancelled / scheduled.
	measure 'Cancellation Rate' = DIVIDE([Cancelled Flights], [Total Flights])
		formatString: 0.00%
		displayFolder: Rates
		lineageTag: c2b9a329-2b0b-5f50-85b5-fa077a9d8015

	/// Diverted / scheduled.
	measure 'Diversion Rate' = DIVIDE([Diverted Flights], [Total Flights])
		formatString: 0.00%
		displayFolder: Rates
		lineageTag: 0dd9b509-3788-5665-8d20-08a1b8679aba

	/// Mean delay in minutes; early flights count as negative.
	measure 'Average Delay (min)' = DIVIDE(SUM(FactAirportDaily[delay_sum_min]), SUM(FactAirportDaily[ontime_den]))
		formatString: 0.0
		displayFolder: Delay
		lineageTag: 5971652c-0065-5d81-aa1e-0f3836841069

	/// Mean arrival delay (ArrDelay).
	measure 'Average Arrival Delay (min)' = CALCULATE([Average Delay (min)], FactAirportDaily[direction] = "arrival")
		formatString: 0.0
		displayFolder: Delay
		lineageTag: d55182da-0baa-5b46-b08d-e7cbf923d046

	/// Mean departure delay (DepDelay).
	measure 'Average Departure Delay (min)' = CALCULATE([Average Delay (min)], FactAirportDaily[direction] = "departure")
		formatString: 0.0
		displayFolder: Delay
		lineageTag: 44306d62-ac2e-58be-8da6-b6386294c7ba

	/// Air-carrier delay minutes.
	measure 'Cause Minutes - Carrier' = SUM(FactAirportDaily[carrier_delay_min])
		formatString: #,0
		displayFolder: Delay causes
		lineageTag: d9884aeb-4fa3-5c89-b92f-9be34ef4cd34

	/// Extreme-weather delay minutes.
	measure 'Cause Minutes - Weather' = SUM(FactAirportDaily[weather_delay_min])
		formatString: #,0
		displayFolder: Delay causes
		lineageTag: 9b33cf8d-3ba9-51e7-b9ab-a4c6fd5e4e57

	/// National Airspace System delay minutes.
	measure 'Cause Minutes - NAS' = SUM(FactAirportDaily[nas_delay_min])
		formatString: #,0
		displayFolder: Delay causes
		lineageTag: 5a2e5d17-bc20-5131-ae76-ccf755f79ca1

	/// Security delay minutes.
	measure 'Cause Minutes - Security' = SUM(FactAirportDaily[security_delay_min])
		formatString: #,0
		displayFolder: Delay causes
		lineageTag: f8b934b0-f658-5835-b2fd-45a6b01eba88

	/// Late-arriving aircraft delay minutes.
	measure 'Cause Minutes - Late Aircraft' = SUM(FactAirportDaily[late_aircraft_delay_min])
		formatString: #,0
		displayFolder: Delay causes
		lineageTag: 0eaf19d7-cfa0-53e5-86fc-85e7691cb387

	/// Sum of attributed delay minutes.
	measure 'Total Cause Minutes' = [Cause Minutes - Carrier] + [Cause Minutes - Weather] + [Cause Minutes - NAS] + [Cause Minutes - Security] + [Cause Minutes - Late Aircraft]
		formatString: #,0
		displayFolder: Delay causes
		lineageTag: 4d306138-642c-583c-abed-991ddbe0f630

	/// Share of attributed minutes coded as extreme weather.
	measure 'Weather Share of Delay Minutes' = DIVIDE([Cause Minutes - Weather], [Total Cause Minutes])
		formatString: 0.0%
		displayFolder: Delay causes
		lineageTag: 3e19ec93-ec95-5b82-8ac6-772e8f117791

	/// Share coded as NAS (includes non-extreme weather handled by ATC).
	measure 'NAS Share of Delay Minutes' = DIVIDE([Cause Minutes - NAS], [Total Cause Minutes])
		formatString: 0.0%
		displayFolder: Delay causes
		lineageTag: a9611c82-e53d-5a92-9034-4cc7f38b18da

	/// On-time rate for the prior month of the current filter context.
	measure 'On-Time % (Previous Month)' = CALCULATE([On-Time %], DATEADD(DimDate[date], -1, MONTH))
		formatString: 0.0%
		displayFolder: Time intelligence
		lineageTag: 8cf45312-ca5f-52d3-9226-01d693761e7a

	/// Percentage-point change vs previous month; blank if not loaded.
	measure 'On-Time % MoM Change (pts)' = VAR cur = [On-Time %] VAR prev = [On-Time % (Previous Month)] RETURN IF(NOT ISBLANK(cur) && NOT ISBLANK(prev), cur - prev)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Time intelligence
		lineageTag: c81a2ebb-5074-5cc9-9613-87df39f34204

	/// Same period one year earlier.
	measure 'On-Time % (Previous Year)' = CALCULATE([On-Time %], SAMEPERIODLASTYEAR(DimDate[date]))
		formatString: 0.0%
		displayFolder: Time intelligence
		lineageTag: b00d12ec-848d-5ca1-80dc-d8bc95c250a9

	/// Percentage-point change vs same period last year; blank if not loaded.
	measure 'On-Time % YoY Change (pts)' = VAR cur = [On-Time %] VAR prev = [On-Time % (Previous Year)] RETURN IF(NOT ISBLANK(cur) && NOT ISBLANK(prev), cur - prev)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Time intelligence
		lineageTag: b3e6e1af-4768-5cba-b23e-4745eb56b14f

	/// Volume growth vs same period last year.
	measure 'Flights YoY Change %' = VAR prev = CALCULATE([Total Flights], SAMEPERIODLASTYEAR(DimDate[date])) RETURN IF(NOT ISBLANK(prev), DIVIDE([Total Flights] - prev, prev))
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Time intelligence
		lineageTag: 7283dd53-7441-5620-9e42-b92075c41c08

	/// 1 = worst average delay among selected airports.
	measure 'Rank by Average Delay' = IF(HASONEVALUE(DimAirport[iata_code]), RANKX(ALLSELECTED(DimAirport[iata_code]), [Average Delay (min)], , DESC, DENSE))
		formatString: 0
		displayFolder: Ranking
		lineageTag: ef5ad78d-34f4-5916-8dbe-48500c633585

	/// 1 = best on-time rate among selected airports.
	measure 'Rank by On-Time %' = IF(HASONEVALUE(DimAirport[iata_code]), RANKX(ALLSELECTED(DimAirport[iata_code]), [On-Time %], , DESC, DENSE))
		formatString: 0
		displayFolder: Ranking
		lineageTag: c072aa7a-3165-5a2e-b7f4-659ee6019160

	/// All monitored airports, same period and direction.
	measure 'Network On-Time %' = CALCULATE([On-Time %], ALL(DimAirport))
		formatString: 0.0%
		displayFolder: Ranking
		lineageTag: e1265e99-c501-5288-befc-2e149af392db

	/// Selected airport's on-time rate minus the network rate.
	measure 'Selected Airport vs Network (pts)' = IF(HASONEVALUE(DimAirport[iata_code]), [On-Time %] - [Network On-Time %])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Ranking
		lineageTag: 9e89c351-9523-553d-aac6-2e0bfd18bee6

	/// Latest loaded BTS month (BTS publishes with a ~2-3 month lag).
	measure 'Data Through' = FORMAT(MAX(DimDate[date]), "mmm yyyy")
		displayFolder: Metadata
		lineageTag: ec085a6c-5349-58c6-95c7-f5199cc5afaf

	/// Operated, non-diverted flights arriving/departing early.
	measure 'Flights Early' = SUM(FactAirportDaily[bucket_early])
		formatString: #,0
		displayFolder: Distribution
		lineageTag: e3baed10-5bc4-5641-8600-8bf61593298b

	/// Operated, non-diverted flights 0-14 minutes late (on time).
	measure 'Flights 0-14 min late' = SUM(FactAirportDaily[bucket_0_14])
		formatString: #,0
		displayFolder: Distribution
		lineageTag: bb8434ae-e749-5220-9118-8245bae5255c

	/// Operated, non-diverted flights 15-29 minutes late.
	measure 'Flights 15-29 min late' = SUM(FactAirportDaily[bucket_15_29])
		formatString: #,0
		displayFolder: Distribution
		lineageTag: aecd00e3-6115-5cf3-ad78-79337660525f

	/// Operated, non-diverted flights 30-59 minutes late.
	measure 'Flights 30-59 min late' = SUM(FactAirportDaily[bucket_30_59])
		formatString: #,0
		displayFolder: Distribution
		lineageTag: 5271e7b1-df42-5a33-b7c9-0c4726a5db63

	/// Operated, non-diverted flights 60-119 minutes late.
	measure 'Flights 60-119 min late' = SUM(FactAirportDaily[bucket_60_119])
		formatString: #,0
		displayFolder: Distribution
		lineageTag: 9ea7d0c5-b49e-5c17-8fc1-6c47eae4e686

	/// Operated, non-diverted flights 120 or more minutes late.
	measure 'Flights 120+ min late' = SUM(FactAirportDaily[bucket_120_plus])
		formatString: #,0
		displayFolder: Distribution
		lineageTag: dd8d4f7f-bb9d-5335-91e9-df2de8628410

	/// Cancellations coded A (carrier).
	measure 'Cancellations - Carrier' = SUM(FactAirportDaily[cancel_carrier])
		formatString: #,0
		displayFolder: Cancellation causes
		lineageTag: 2d5664cb-0766-5e61-87c3-8c5e3a21fe4c

	/// Cancellations coded B (weather).
	measure 'Cancellations - Weather' = SUM(FactAirportDaily[cancel_weather])
		formatString: #,0
		displayFolder: Cancellation causes
		lineageTag: 17cd03ef-4ed8-5c28-beb6-61b4f2ddbae4

	/// Cancellations coded C (National Airspace System).
	measure 'Cancellations - NAS' = SUM(FactAirportDaily[cancel_nas])
		formatString: #,0
		displayFolder: Cancellation causes
		lineageTag: 7c24b54f-b040-547b-8ef7-1db4a1e2f80a

	/// Cancellations coded D (security).
	measure 'Cancellations - Security' = SUM(FactAirportDaily[cancel_security])
		formatString: #,0
		displayFolder: Cancellation causes
		lineageTag: 3b30b013-5e19-52ef-b546-7e0c8ed48e20

