	partition FactAirportDaily = m
		mode: import
		source =
				let
				    Source = Parquet.Document(Binary.Buffer(Web.Contents(DataUrl, [RelativePath = "fact_airport_daily.parquet"]))),
				    Typed = Table.TransformColumnTypes(Source, {{"airport_iata", type text}, {"flight_date", type date}, {"direction", type text}, {"flights", Int64.Type}, {"cancelled", Int64.Type}, {"diverted", Int64.Type}, {"ontime_den", Int64.Type}, {"ontime_num", Int64.Type}, {"delayed_15", Int64.Type}, {"cancel_carrier", Int64.Type}, {"cancel_weather", Int64.Type}, {"cancel_nas", Int64.Type}, {"cancel_security", Int64.Type}, {"bucket_early", Int64.Type}, {"bucket_0_14", Int64.Type}, {"bucket_15_29", Int64.Type}, {"bucket_30_59", Int64.Type}, {"bucket_60_119", Int64.Type}, {"bucket_120_plus", Int64.Type}, {"delay_sum_min", Int64.Type}, {"carrier_delay_min", Int64.Type}, {"weather_delay_min", Int64.Type}, {"nas_delay_min", Int64.Type}, {"security_delay_min", Int64.Type}, {"late_aircraft_delay_min", Int64.Type}})
				in
				    Typed
