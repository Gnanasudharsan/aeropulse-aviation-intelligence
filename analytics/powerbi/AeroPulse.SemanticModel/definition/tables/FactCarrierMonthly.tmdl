table FactCarrierMonthly
	lineageTag: 7c0ce8a5-011c-5ade-b165-73c52cb61692

	/// Flights by reporting carrier.
	measure 'Carrier Flights' = SUM(FactCarrierMonthly[flights])
		formatString: #,0
		displayFolder: Carrier
		lineageTag: d38227f9-4cbc-5874-bf69-77984585d95c

	/// On-time rate by reporting carrier.
	measure 'Carrier On-Time %' = DIVIDE(SUM(FactCarrierMonthly[ontime_num]), SUM(FactCarrierMonthly[ontime_den]))
		formatString: 0.0%
		displayFolder: Carrier
		lineageTag: 85c0eb78-ac05-5755-ab19-e7a5e2e63f4e

