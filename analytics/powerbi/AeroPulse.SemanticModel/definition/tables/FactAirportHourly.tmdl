table FactAirportHourly
	lineageTag: bee3dfe8-c179-5bf6-a1be-8d948fad913b

	/// Flights by scheduled local hour.
	measure 'Hourly Flights' = SUM(FactAirportHourly[flights])
		formatString: #,0
		displayFolder: Hourly
		lineageTag: 37f1aee2-173e-50bc-9d26-6a522adcdb97

	/// On-time rate by scheduled local hour.
	measure 'Hourly On-Time %' = DIVIDE(SUM(FactAirportHourly[ontime_num]), SUM(FactAirportHourly[ontime_den]))
		formatString: 0.0%
		displayFolder: Hourly
		lineageTag: 1761210c-db2a-5a64-a230-f78d3d8860fc

