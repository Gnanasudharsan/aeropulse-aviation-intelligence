// AeroPulse DAX measures (generated by analytics/powerbi/generate_pbip.py — do not edit by hand)

// Volume · Scheduled flight legs at the selected airports (each flight counts once per direction selected).
[Total Flights] =
    SUM(FactAirportDaily[flights])

// Volume · Scheduled arrivals.
[Arrival Flights] =
    CALCULATE([Total Flights], FactAirportDaily[direction] = "arrival")

// Volume · Scheduled departures.
[Departure Flights] =
    CALCULATE([Total Flights], FactAirportDaily[direction] = "departure")

// Volume · BTS-reported cancellations.
[Cancelled Flights] =
    SUM(FactAirportDaily[cancelled])

// Volume · BTS-reported diversions.
[Diverted Flights] =
    SUM(FactAirportDaily[diverted])

// Volume · Operated, non-diverted flights 15+ minutes late (DOT definition).
[Delayed Flights] =
    SUM(FactAirportDaily[delayed_15])

// Rates · On-time (< 15 min late) / operated non-diverted flights with a reported delay. Cancelled and diverted excluded.
[On-Time %] =
    DIVIDE(SUM(FactAirportDaily[ontime_num]), SUM(FactAirportDaily[ontime_den]))

// Rates · DOT arrival on-time rate.
[Arrival On-Time %] =
    CALCULATE([On-Time %], FactAirportDaily[direction] = "arrival")

// Rates · Departure on-time rate.
[Departure On-Time %] =
    CALCULATE([On-Time %], FactAirportDaily[direction] = "departure")

// Rates · Cancelled / scheduled.
[Cancellation Rate] =
    DIVIDE([Cancelled Flights], [Total Flights])

// Rates · Diverted / scheduled.
[Diversion Rate] =
    DIVIDE([Diverted Flights], [Total Flights])

// Delay · Mean delay in minutes; early flights count as negative.
[Average Delay (min)] =
    DIVIDE(SUM(FactAirportDaily[delay_sum_min]), SUM(FactAirportDaily[ontime_den]))

// Delay · Mean arrival delay (ArrDelay).
[Average Arrival Delay (min)] =
    CALCULATE([Average Delay (min)], FactAirportDaily[direction] = "arrival")

// Delay · Mean departure delay (DepDelay).
[Average Departure Delay (min)] =
    CALCULATE([Average Delay (min)], FactAirportDaily[direction] = "departure")

// Delay causes · Air-carrier delay minutes.
[Cause Minutes - Carrier] =
    SUM(FactAirportDaily[carrier_delay_min])

// Delay causes · Extreme-weather delay minutes.
[Cause Minutes - Weather] =
    SUM(FactAirportDaily[weather_delay_min])

// Delay causes · National Airspace System delay minutes.
[Cause Minutes - NAS] =
    SUM(FactAirportDaily[nas_delay_min])

// Delay causes · Security delay minutes.
[Cause Minutes - Security] =
    SUM(FactAirportDaily[security_delay_min])

// Delay causes · Late-arriving aircraft delay minutes.
[Cause Minutes - Late Aircraft] =
    SUM(FactAirportDaily[late_aircraft_delay_min])

// Delay causes · Sum of attributed delay minutes.
[Total Cause Minutes] =
    [Cause Minutes - Carrier] + [Cause Minutes - Weather] + [Cause Minutes - NAS] + [Cause Minutes - Security] + [Cause Minutes - Late Aircraft]

// Delay causes · Share of attributed minutes coded as extreme weather.
[Weather Share of Delay Minutes] =
    DIVIDE([Cause Minutes - Weather], [Total Cause Minutes])

// Delay causes · Share coded as NAS (includes non-extreme weather handled by ATC).
[NAS Share of Delay Minutes] =
    DIVIDE([Cause Minutes - NAS], [Total Cause Minutes])

// Time intelligence · On-time rate for the prior month of the current filter context.
[On-Time % (Previous Month)] =
    CALCULATE([On-Time %], DATEADD(DimDate[date], -1, MONTH))

// Time intelligence · Percentage-point change vs previous month; blank if not loaded.
[On-Time % MoM Change (pts)] =
    VAR cur = [On-Time %] VAR prev = [On-Time % (Previous Month)] RETURN IF(NOT ISBLANK(cur) && NOT ISBLANK(prev), cur - prev)

// Time intelligence · Same period one year earlier.
[On-Time % (Previous Year)] =
    CALCULATE([On-Time %], SAMEPERIODLASTYEAR(DimDate[date]))

// Time intelligence · Percentage-point change vs same period last year; blank if not loaded.
[On-Time % YoY Change (pts)] =
    VAR cur = [On-Time %] VAR prev = [On-Time % (Previous Year)] RETURN IF(NOT ISBLANK(cur) && NOT ISBLANK(prev), cur - prev)

// Time intelligence · Volume growth vs same period last year.
[Flights YoY Change %] =
    VAR prev = CALCULATE([Total Flights], SAMEPERIODLASTYEAR(DimDate[date])) RETURN IF(NOT ISBLANK(prev), DIVIDE([Total Flights] - prev, prev))

// Ranking · 1 = worst average delay among selected airports.
[Rank by Average Delay] =
    IF(HASONEVALUE(DimAirport[iata_code]), RANKX(ALLSELECTED(DimAirport[iata_code]), [Average Delay (min)], , DESC, DENSE))

// Ranking · 1 = best on-time rate among selected airports.
[Rank by On-Time %] =
    IF(HASONEVALUE(DimAirport[iata_code]), RANKX(ALLSELECTED(DimAirport[iata_code]), [On-Time %], , DESC, DENSE))

// Ranking · All monitored airports, same period and direction.
[Network On-Time %] =
    CALCULATE([On-Time %], ALL(DimAirport))

// Ranking · Selected airport's on-time rate minus the network rate.
[Selected Airport vs Network (pts)] =
    IF(HASONEVALUE(DimAirport[iata_code]), [On-Time %] - [Network On-Time %])

// Metadata · Latest loaded BTS month (BTS publishes with a ~2-3 month lag).
[Data Through] =
    FORMAT(MAX(DimDate[date]), "mmm yyyy")

// Distribution · Operated, non-diverted flights arriving/departing early.
[Flights Early] =
    SUM(FactAirportDaily[bucket_early])

// Distribution · Operated, non-diverted flights 0-14 minutes late (on time).
[Flights 0-14 min late] =
    SUM(FactAirportDaily[bucket_0_14])

// Distribution · Operated, non-diverted flights 15-29 minutes late.
[Flights 15-29 min late] =
    SUM(FactAirportDaily[bucket_15_29])

// Distribution · Operated, non-diverted flights 30-59 minutes late.
[Flights 30-59 min late] =
    SUM(FactAirportDaily[bucket_30_59])

// Distribution · Operated, non-diverted flights 60-119 minutes late.
[Flights 60-119 min late] =
    SUM(FactAirportDaily[bucket_60_119])

// Distribution · Operated, non-diverted flights 120 or more minutes late.
[Flights 120+ min late] =
    SUM(FactAirportDaily[bucket_120_plus])

// Cancellation causes · Cancellations coded A (carrier).
[Cancellations - Carrier] =
    SUM(FactAirportDaily[cancel_carrier])

// Cancellation causes · Cancellations coded B (weather).
[Cancellations - Weather] =
    SUM(FactAirportDaily[cancel_weather])

// Cancellation causes · Cancellations coded C (National Airspace System).
[Cancellations - NAS] =
    SUM(FactAirportDaily[cancel_nas])

// Cancellation causes · Cancellations coded D (security).
[Cancellations - Security] =
    SUM(FactAirportDaily[cancel_security])

// Hourly · Flights by scheduled local hour.
[Hourly Flights] =
    SUM(FactAirportHourly[flights])

// Hourly · On-time rate by scheduled local hour.
[Hourly On-Time %] =
    DIVIDE(SUM(FactAirportHourly[ontime_num]), SUM(FactAirportHourly[ontime_den]))

// Carrier · Flights by reporting carrier.
[Carrier Flights] =
    SUM(FactCarrierMonthly[flights])

// Carrier · On-time rate by reporting carrier.
[Carrier On-Time %] =
    DIVIDE(SUM(FactCarrierMonthly[ontime_num]), SUM(FactCarrierMonthly[ontime_den]))
