# ---------------------------------------------------------------------------
# AeroPulse environment template. Copy to `.env` and adjust. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Database (docker-compose exposes Postgres+TimescaleDB on host port 5442)
POSTGRES_USER=aeropulse
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=aeropulse
DATABASE_URL=postgresql+psycopg://aeropulse:change-me-locally@localhost:5442/aeropulse

# --- API
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3100
RATE_LIMIT_PER_MINUTE=120
# Identify ourselves to upstream government APIs (AWC asks for a descriptive UA)
HTTP_USER_AGENT=AeroPulse/1.0 (+https://github.com/Gnanasudharsan/aeropulse-aviation-intelligence)
# Protects POST /api/v1/admin/ingest/* (used by external cron). Leave blank to disable.
INGEST_TRIGGER_TOKEN=

# --- Worker / scheduler
SCHEDULER_ENABLED=true
FAA_POLL_SECONDS=300
METAR_POLL_SECONDS=600
TAF_POLL_SECONDS=1800

# --- Frontend (apps/web)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Power BI: a "Publish to web" URL or a secure embed URL. Leave blank until published.
NEXT_PUBLIC_POWERBI_REPORT_URL=
